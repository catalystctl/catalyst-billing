# Copy to .env and adjust. .env is git-ignored; this file is not secret.
#
# Every variable the binary reads is listed here, grouped by what it configures, with the
# value the code uses when it is unset. A variable marked REQUIRED has no default and the
# feature that needs it fails loudly without it — that is deliberate, because a silently
# defaulted credential is a production incident waiting for a deploy.
#
# The two dev-only sections at the bottom (database cluster credentials, admin CLI password)
# carry values that must never be reused outside a workstation.

# ---------------------------------------------------------------- database --
#
# REQUIRED. The runtime connection. `billing serve`, `billing worker`, `billing admin` and
# the test harness all refuse to start without it.
BILLING_DATABASE_URL=postgres://billing:devonly-billing-owner@127.0.0.1:5442/catalyst_billing?sslmode=disable

# Optional. The connection used by `billing migrate`, when migrations need a role with DDL
# rights and the runtime role must not have them. Empty means "use BILLING_DATABASE_URL".
BILLING_MIGRATION_DATABASE_URL=

# Optional. Connection pool ceiling per process. Empty means the pgx default.
BILLING_DB_MAX_CONNS=

# NOT READ BY THE BINARY. Kept because it names a real idea: the restricted app-role URL for
# the main database. Nothing in this repository consumes it — `serve`, `worker`, `admin` and
# `migrate` all use BILLING_DATABASE_URL, and only the *_TEST_* pair has a runtime/test split.
#
# To actually run least-privilege, point BILLING_DATABASE_URL at this URL and keep
# BILLING_MIGRATION_DATABASE_URL on the owner role, so the serving process cannot DDL.
BILLING_APP_DATABASE_URL=postgres://billing_app:devonly-billing-app@127.0.0.1:5442/catalyst_billing?sslmode=disable

# ------------------------------------------------------------ http server --
#
# Optional. Where the panel listens. Default 127.0.0.1:8080. Bind to 127.0.0.1 unless a
# proxy in front of it terminates TLS: the panel sets Secure cookies and HSTS, and serving
# it directly over plain HTTP on a public interface defeats both.
BILLING_HTTP_ADDR=127.0.0.1:8791

# Optional. The origin the panel is reachable at. Default http://127.0.0.1:8080.
#
# This is a security boundary, not a cosmetic base URL: the same-origin check on every
# mutation compares the request's Origin header against the Host it was sent to, and
# notification links are made absolute from this value. Set it to exactly what the browser
# types, including the port — a mismatch answers 403 bad_origin on sign-in.
BILLING_PUBLIC_URL=http://localhost:8791

# Optional. Comma-separated CIDRs whose X-Forwarded-* headers are believed. Empty (the safe
# default) means the panel is directly exposed and no forwarding header is trusted.
#
# Only list your proxy. When this is empty, a client cannot choose its own throttling bucket,
# lock out another address, poison the audit log, or defeat the Origin check by sending
# X-Forwarded-Host. When it is set too broadly, it can do all four.
BILLING_TRUSTED_PROXIES=

# Optional. Marks session cookies Secure (the default). Set to 1 only when serving the panel
# over plain HTTP on loopback, where a Secure cookie would never be sent back.
#
# It is a kill switch: 1, true or yes all disable the Secure flag. Unset it once TLS is in
# place — the server warns at startup for as long as it is set.
BILLING_INSECURE_COOKIES=

# Optional. The key used to encrypt TOTP secrets at rest. REQUIRED for any MFA enrolment:
# without it, `authn.ErrMFAKeyMissing` is returned and enrolment is refused.
#
# Must be 32 bytes, as 64 hex characters or raw base32. Anything else is refused rather than
# padded, because a short key silently weakened is worse than a startup failure. Generate
# one with: openssl rand -hex 32
BILLING_MFA_KEY=

# Optional. A label for the MFA key, so a rotation can identify which key encrypted a secret.
# Default "primary".
BILLING_MFA_KEY_ID=

# ---------------------------------------------------------------- payments --
#
# Optional individually, but a payment cannot settle without all four of the first group.
BILLING_GATEWAY_PROVIDER=
BILLING_GATEWAY_ACCOUNT=

# REQUIRED to accept a webhook: the shared secret the provider signs deliveries with. Empty
# means every delivery is rejected, which is the correct default for an unconfigured panel.
BILLING_WEBHOOK_SECRET=

# REQUIRED for the payments job. Path to the gateway extension binary, spoken to over
# JSON-RPC. Without it the job fails every cycle with "missing required configuration" — for
# a UI-only evaluation, set BILLING_DISABLE_PAYMENTS=1 below instead.
BILLING_GATEWAY_EXTENSION=

# Optional. Absolute URLs the gateway redirects to. Default to
# $BILLING_PUBLIC_URL/checkout/complete and /checkout/cancelled.
BILLING_CHECKOUT_SUCCESS_URL=
BILLING_CHECKOUT_CANCEL_URL=

# --------------------------------------------- gateway extension: Stripe --
#
# These are read by the extension process (extensions/stripe), not by the core, and they are
# passed through the extension host. The secret lives in the extension's environment rather than
# the panel's, so a hung or panicking HTTP client cannot take the panel down and the core's own
# tests never need a live key.
#
# To use it: set BILLING_GATEWAY_EXTENSION to the built binary and BILLING_GATEWAY_PROVIDER=stripe.
#
# REQUIRED. The API key, sk_test_… or sk_live_….
STRIPE_SECRET_KEY=
# REQUIRED to accept a webhook: the signing secret, whsec_…. Without it every delivery is
# rejected, which is the correct default for an unconfigured gateway.
STRIPE_WEBHOOK_SECRET=
# Optional. Defaults to https://api.stripe.com. Tests point it at a local server, which is what
# makes the adapter testable with no network access.
STRIPE_API_BASE=
# Optional. Comma-separated currency codes to advertise. Defaults to the set Stripe settles in
# most jurisdictions.
STRIPE_CURRENCIES=
# Optional. Echoed in `describe` so the panel can show it. Not used for any request.
STRIPE_PUBLISHABLE_KEY=
# Optional. Per-call HTTP timeout in milliseconds. Default 20000.
STRIPE_TIMEOUT_MS=
# Optional. Webhook timestamp tolerance in seconds; a delivery older than this is refused as a
# replay. Default 300. Must be a positive integer.
STRIPE_WEBHOOK_TOLERANCE_S=

# ----------------------------------------------------------- provisioning --
#
# REQUIRED for the provisioning job. Path to the provisioner extension binary. Without it the
# job fails every cycle; for a UI-only evaluation set BILLING_DISABLE_PROVISIONING=1.
BILLING_PROVISIONER_EXTENSION=

# --------------------------------------------------- merchant and invoicing --
#
# Optional. Shown on every issued document. The country drives tax resolution; empty means
# no jurisdiction is recorded, which is honest but leaves the tax evidence blank.
BILLING_MERCHANT_NAME=
BILLING_MERCHANT_COUNTRY=

# Optional. The tax rate applied by the worker's renewal run, as an exact rational. Default
# "0%". Percentages are parsed exactly: 12.5% is 1/8, never 0.125.
BILLING_TAX_RATE=0%

# Optional. How the rate is applied: "none", "inclusive" or "exclusive". Default "none".
BILLING_TAX_POLICY=none

# Optional. The terms line printed on a renewal invoice. Default
# "Renews automatically until cancelled."
BILLING_RENEWAL_TERMS=

# -------------------------------------------------------------------- mail --
#
# Optional. Leave BILLING_SMTP_HOST empty and notifications are written to the log instead of
# being sent — which is what makes local development work without a mail server, and what a
# production deployment must not leave unset.
BILLING_SMTP_HOST=
BILLING_SMTP_PORT=587
BILLING_SMTP_USERNAME=
BILLING_SMTP_PASSWORD=
BILLING_SMTP_FROM=

# ----------------------------------------------------------------- logging --
#
# Optional. Level: debug, info, warn or error. Default info.
BILLING_LOG_LEVEL=info
# Optional. Format: text or json. Default text. Use json when shipping to a log collector.
BILLING_LOG_FORMAT=text

# ---------------------------------------------------------------- approvals --
#
# Optional. A refund at or above this amount in minor units needs a second signature.
# Malformed values are refused rather than defaulted, because a silent fallback would quietly
# lower the bar.
BILLING_REFUND_APPROVAL_THRESHOLD_MINOR=
# Optional. A termination batch of at least this many services needs a second signature.
BILLING_TERMINATION_BATCH_APPROVAL=

# ------------------------------------------------------------------- worker --
#
# Optional. Run the background jobs inside the `serve` process instead of a separate
# `billing worker`. Default off.
#
# Off is the correct production setting: the jobs then have their own process, so a job that
# pegs the CPU or panics cannot take the panel down with it. Turn it on for a single-container
# deployment or a quick manual test. Takes 1, true or yes. The `--embedded-worker` flag
# overrides it.
BILLING_EMBEDDED_WORKER=

# ------------------------------------------------------------- kill switches --
#
# Optional. Each takes 1, true or yes. They are the operator's emergency brake: a misbehaving
# gateway, provisioner or mailer can be stopped without a redeploy. The server and the UI keep
# working; only the named job stops.
#
# The worker logs a warning per disabled job at startup, so a switch left on is visible rather
# than a mystery.
BILLING_DISABLE_PAYMENTS=
BILLING_DISABLE_PROVISIONING=
BILLING_DISABLE_SUSPENSION=
BILLING_DISABLE_REFUND_RECONCILE=
BILLING_DISABLE_NOTIFICATIONS=
# The two lifecycle rules: cancelling an unpaid order after cronjob.order_cancel_days, and
# terminating a long-suspended service after cronjob.terminate_days. These are separated from
# the switches above because terminating a customer's server is the one action an operator must
# be able to stop instantly, on its own, without stopping anything else.
BILLING_DISABLE_ORDER_CANCEL=
BILLING_DISABLE_TERMINATION=
# The price-change queue: applies paid upgrades, credits and applies downgrades, and voids upgrade
# invoices nobody paid. It has its own switch because it is the job that *voids documents* — an
# operator whose catalogue produced a burst of wrong upgrade prices needs to stop that without
# stopping terminations or order cancellation.
BILLING_DISABLE_SERVICE_UPGRADES=

# ------------------------------------------------------------------ testing --
#
# Optional. The database the Go tests run against. Each package derives its own database from
# this name, so packages can run in parallel without sharing tables.
BILLING_TEST_DSN=postgres://billing:devonly-billing-owner@127.0.0.1:5442/billing_test?sslmode=disable
# Optional. Runtime-role connection to the test database, used to prove the role cannot DDL.
BILLING_APP_TEST_DSN=postgres://billing_app:devonly-billing-app@127.0.0.1:5442/billing_test?sslmode=disable
# Optional. Set to 1 to make a missing database a failure instead of a skip. CI must set it:
# a test suite that silently skips every database test is green and worthless.
BILLING_REQUIRE_DB=
# Optional. Set to 1 to run the packages against one shared database instead of one each.
# Useful when the cluster has a connection limit, slower because the packages serialise.
BILLING_TEST_SHARED_DB=

# ----------------------------------------------------------- dev helper ------
#
# Optional. Read by scripts/dev-ui.sh, not by the binary: the address its dev server binds and
# prints. Default 127.0.0.1:8791. It exists so the dev wrapper and BILLING_HTTP_ADDR can be
# kept in step without editing the script.
BILLING_DEV_ADDR=127.0.0.1:8791

# --------------------------------------------------------------- admin CLI --
#
# Optional. Read by `billing admin create-user` when no --password flag is given. A flag is
# visible in `ps`, so the environment or stdin is preferred.
#
# DEV ONLY. Never set this in a production environment file: it is a known password for every
# account the CLI creates.
BILLING_ADMIN_PASSWORD=

# Optional. The user the admin CLI attributes an action to when no --actor flag is given, so
# `billing admin setting set` writes an audit row naming a person rather than "system". When it
# names a user, that user's permissions are checked against the action, which is what stops the
# CLI from being a way around the panel's authorization.
BILLING_ADMIN_ACTOR=

# ------------------------------------------- dev-only database credentials --
#
# These are for the dedicated loopback-only cluster in compose.yaml. Production credentials
# must be generated, not copied from here.

POSTGRES_PORT=5442
POSTGRES_SUPERUSER=billing
POSTGRES_SUPERUSER_PASSWORD=devonly-billing-owner
POSTGRES_DB=catalyst_billing
APP_ROLE_PASSWORD=devonly-billing-app
