/bin/
/dist/
*.test
*.out
node_modules/

# Development credentials for the loopback test cluster. The template
# (.env.example) is committed; the real file must never be.
.env
coverage.out

# Built by the extension tests into the working directory; never committed.
/example-hooks

# Written by scripts/browser-e2e.sh during a run; never committed.
web/dist/e2e-driver.js
web/dist/e2e.html
/billing

# Built by `go build ./extensions/catalystctl`. A 9 MB binary in the tree is not source, and a
# committed one goes stale silently: the copy everybody runs is the one from their last build,
# while the repository says something else.
/catalystctl
