  },
  "typography": {
    "display": {
      "family": "Space Grotesk",
      "fallback": "system-ui, sans-serif",
      "weights": [
        700,
        800
      ]
    },
    "body": {
      "family": "Inter",
      "fallback": "system-ui, sans-serif",
      "weights": [
        400,
        600
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallback": "ui-monospace, monospace",
      "weights": [
        400,
        600
      ]
    },
    "scale": {
      "xs": "0.6875rem",
      "sm": "0.75rem",
      "base": "0.875rem",
      "md": "0.9375rem",
      "lg": "1.0625rem",
      "xl": "1.25rem",
      "2xl": "1.75rem",
      "3xl": "2.75rem"
    },
    "leading": {
      "tight": "1.05",
      "snug": "1.2",
      "normal": "1.4"
    },
    "tracking": {
      "tight": "-0.02em",
      "wide": "0.12em"
    }
  },
  "space": {
    "unit": 4,
    "density": "compact",
    "scale": [
      0.25,
      0.5,
      0.75,
      1,
      1.5,
      2,
      3,
      4
    ]
  },
  "shape": {
    "radius": {
      "xs": "0px",
      "sm": "0px",
      "md": "0px",
      "lg": "0px",
      "xl": "0px",
      "full": "0px"
    },
    "borderWidth": "2px"
  },
  "layout": {
    "shell": {
      "nav": "topbar",
      "sidebarWidth": "0px",
      "topbarHeight": "60px",
      "contentMax": "1600px",
      "cardStyle": "outlined",
      "tableStyle": "comfortable",
      "breadcrumbs": true
    }
  },
  "components": {
    "button": {
      "height": "38px",
      "radius": "0px",
      "uppercase": true
    },
    "input": {
      "height": "38px",
      "radius": "0px"
    },
    "card": {
      "radius": "0px",
      "padding": "18px"
    }
  },
  "elevation": {
    "dark": {
      "1": "none",
      "2": "6px 6px 0 #000000",
      "3": "10px 10px 0 #000000"
    },
    "light": {
      "1": "none",
      "2": "6px 6px 0 #111111",
      "3": "10px 10px 0 #111111"
    }
  }
}
